@{
    ViewData["Title"] = "Cryptids Page";
}

<div class="text-center">
    <h1 class="display-4">Cryptid Registry</h1>

    @model List<Cryptid>

    <p>@Model.Count Cryptids in the registry.</p>

    <ul>
        @foreach (var cryptid in Model)
        {
            <li>@cryptid.Name — @cryptid.Region</li><a href="/Cryptids/Details/@cryptid.Id">View Details</a>
        }
    </ul>
</div>
