@model List<Creeds>

@{
    ViewData["Title"] = "Way of the Force Page";
}

<div class="text-center">
    <h1 class="display-4">Star Wars Alliance Creed Database</h1>
    <p>@Model.Count Alliances in the Star Wars Galaxy database.</p>
</div>

@if (Model.Count > 0)
{
    foreach (var creed in Model)
    {
        <partial name="_CreedCard" model="creed" />
        <a asp-action="Details" asp-route-id="@creed.Id" class="d-block mb-4">View Details</a>
    }
}
else
{
    <p class="text-muted text-center">No alliances recorded yet.</p>
    <p class="text-center"><a asp-action="Create" class="btn btn-primary">＋ Add the first alliance</a></p>
}

