@model List<Creeds>

@{
    ViewData["Title"] = "Creeds of the Galaxy";
}

<div class="text-center mb-4">
    <h1 class="display-4">Creeds of the Galaxy</h1>
    <p>@Model.Count creed@(Model.Count == 1 ? "" : "s") in the Star Wars archive.</p>
</div>

@if (Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        @foreach (var creed in Model)
        {
            <div class="col">
                <partial name="_CreedCard" model="creed" />
            </div>
        }
    </div>
}
else
{
    <p class="text-muted text-center">No creeds recorded yet.</p>
    <p class="text-center"><a asp-action="Create" class="btn btn-primary">＋ Add the first creed</a></p>
}
