@model Creeds
@{
    ViewData["Title"] = $"Remove: {Model.CreedName}";
}

<h1>Remove this Creed? 🗑️</h1>
<p class="text-muted">This takes it off the list for good. There is no undo.</p>

<div class="col-md-4 mb-4">
    <partial name="_CreedCard" model="Model" />
</div>

@if (Model.Holocrons.Count > 0)
{
    <div class="alert alert-warning">
        This creed has <strong>@Model.Holocrons.Count</strong> holocron@(Model.Holocrons.Count == 1 ? "" : "s") in its archive.
        Removing the creed destroys @(Model.Holocrons.Count == 1 ? "it" : "them") too.
    </div>
}

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Remove it</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Keep it</a>
</form>