@{
    ViewData["Title"] = "Add an alliance";
}

<h1>Add an alliance</h1>

<form method="post">
    <label>Name <input name="CreedName" /></label>
    <label>Creed <input name="Creed" /></label>
    <label>Force Affinity <input name="Affinity" /></label>
    <label>Total Holocrons <input name="TotalHolocrons" /></label>
    <label>Friendly <input type="checkbox" name="IsFriendly" value="true" /></label>
    <button type="submit">Add it</button>
</form>
