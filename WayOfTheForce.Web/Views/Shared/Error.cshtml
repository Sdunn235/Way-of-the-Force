@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-5">A disturbance in the Force</h1>
    <p class="lead">Something went wrong on our side, not yours. Try again in a minute.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to the front page</a>
</div>
