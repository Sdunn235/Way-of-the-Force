@model Creeds

@{
    // Affinity runs -100 (dark) to 100 (light). A word reads better than a bare number.
    var forceLean = Model.Affinity switch
    {
        >= 50 => "Light side",
        > 10 => "Leans light",
        >= -10 => "Balanced",
        > -50 => "Leans dark",
        _ => "Dark side"
    };

    // Details and Delete show this card too, and a link to the page you're on goes nowhere.
    var onListPage = ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<div class="card h-100">
    <div class="card-body">
        <h5 class="card-title">@Model.CreedName</h5>
        <p class="card-text">@Model.Creed</p>
        <ul class="list-unstyled mb-0">
            <li>Homeworld: @(Model.Homeworld ?? "Unknown")</li>
            <li>The Force: @forceLean (@Model.Affinity)</li>
            <li>Friendly: @(Model.IsFriendly ? "Yes" : "No")</li>
        </ul>
    </div>
    <div class="card-footer d-flex justify-content-between">
        @if (onListPage)
        {
            <a href="/Creeds/Details/@Model.Id">Details</a>
        }
        <span class="text-muted small ms-auto">@Model.Holocrons.Count holocron@(Model.Holocrons.Count == 1 ? "" : "s") archived</span>
    </div>
</div>
