@model Creeds

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.CreedName</h5>
        <p class="card-text">@Model.Creed</p>
        <ul class="list-unstyled mb-0">
            <li>Homeworld: @(Model.Homeworld ?? "Unknown")</li>
            <li>Force Affinity: @Model.Affinity</li>
            <li>Total Holocrons: @Model.TotalHolocrons</li>
            <li>Friendly: @(Model.IsFriendly ? "Yes" : "No")</li>
        </ul>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a href="/Creeds/Details/@Model.Id">Details</a>
        <span class="text-muted small">@Model.Holocrons.Count on the archive</span>
    </div>
</div>
